# ── Database ──────────────────────────────────────────────
POSTGRES_USER=case_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=case_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── API ───────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_me_in_production
API_CORS_ORIGINS=["http://localhost:3000"]

# ── JWT ───────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Vault encryption (AES-256-GCM) ──────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
VAULT_ENCRYPTION_KEY=change_me_in_production_64_hex_chars_00000000000000000000000000000000
# Set the old key here during rotation so existing tokens can still be read.
VAULT_ENCRYPTION_KEY_PREVIOUS=

# ── Google OAuth (optional) ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ── Web ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://api:8000
